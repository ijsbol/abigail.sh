[Unit]
Description=abigail.sh FastAPI service
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/opt/websites/abigail.sh
ExecStartPre=/opt/websites/abigail.sh/.venv/bin/playwright install chromium
ExecStart=/opt/websites/abigail.sh/.venv/bin/uvicorn src.abi:app --host 127.0.0.1 --port 7867 --ws websockets-sansio --http h11 --h11-max-incomplete-event-size 4194304

[Install]
WantedBy=multi-user.target
