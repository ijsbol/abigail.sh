{% extends "_" + host + ".jinja2" %}
{% set title = "blog" %}
{% set description = "long and short form writing - technical breakdowns, research, and informal brain babble." %}

{% block head %}
    <link rel="stylesheet" href="{{ get_file('public/css/blog.css') }}" />
{% endblock %}

{% block page_content %}
<p>
    long and short form writing - technical breakdowns of projects and
    research alongside shorter, more informal notes.

    <br>

    <a href="/blog.rss" target="_blank" style="display: block; margin-top: 15px; margin-bottom: 15px;">
        <img
            src="{{ get_file("public/images/buttons/vanity/rss.png") }}"
            alt="vanity 88x31px button"
            width="88"
            height="31"
            loading="lazy"
            style="image-rendering:pixelated"
        />
    </a>
</p>
<br />
<div class="post-gallery">
    {% for post in posts %}
    <a href="/blog/{{ post.slug }}">
        <div class="post-entry">
            <div class="title split-div">
                <div>{{ post.title }}</div>
            </div>
            <div class="duration split-div">
                <div>{{ post.duration }}</div>
                <div>{{ post.date }}</div>
            </div>
            <div class="tags">
                {% for tag in post.tags %}
                <div class="tag">{{ tag }}</div>
                {% endfor %}
            </div>
        </div>
    </a>
    {% endfor %}
</div>
{% endblock %}
